//@version=6
strategy("MMC Adaptive V4 - UNIVERSAL AUTO OPTIMIZE + CLEAR SIGNALS", shorttitle="MMC UNIVERSAL AO", overlay=true, pyramiding=0, process_orders_on_close=true, max_labels_count=500, max_bars_back=5000)

// Universal MMC version.
// ALL original historical signals remain visible.
// Confirmed BUY = below candle, confirmed SELL = above candle.
// Live BUY/SELL appears on the currently forming candle.
// Strategy name is shown with every signal.
// Auto optimizer only controls NEW trades; it never hides chart signals.

groupSignal = "SIGNAL"
confirmedOnly = input.bool(true, "Confirmed Candle For Trading", group=groupSignal)
allowLong = input.bool(true, "Allow BUY", group=groupSignal)
allowShort = input.bool(true, "Allow SELL", group=groupSignal)
tradeOnly1m = input.bool(false, "Only trade on 1-minute", group=groupSignal)

groupDisplay = "SIGNAL DISPLAY"
showSignals = input.bool(true, "Show ALL Historical BUY/SELL", group=groupDisplay)
showLiveSignal = input.bool(true, "Show Running/Live Signal", group=groupDisplay)
showSignalStrategy = input.bool(true, "Show Strategy Name", group=groupDisplay)

groupOpt = "AUTO OPTIMIZER"
autoDisable = input.bool(true, "Auto-disable weakest strategy for TRADING", group=groupOpt)
minTrades = input.int(20, "Minimum completed trades before disabling", minval=1, group=groupOpt)
minWinRate = input.float(45.0, "Disable if weakest Win % is below", minval=0, maxval=100, step=0.5, group=groupOpt)
showStats = input.bool(true, "Show Stats", group=groupOpt)

is1m = timeframe.isminutes and timeframe.multiplier == 1
src = close

ema20 = ta.ema(src, 20)
ema50 = ta.ema(src, 50)

prevClose = nz(close[1], close)
tr1 = high - low
tr2 = math.abs(high - prevClose)
tr3 = math.abs(low - prevClose)
trueRange = math.max(tr1, math.max(tr2, tr3))
atr14 = ta.sma(trueRange, 14)
atrPct = close != 0 ? atr14 / close : 0.0

emaGapPct = close != 0 ? math.abs(ema20 - ema50) / close : 0.0
emaSlopePct = math.abs(ta.roc(ema20, 5) / 100.0)

bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20)
bbUpper = bbBasis + 2.0 * bbDev
bbLower = bbBasis - 2.0 * bbDev
bbWidth = bbBasis != 0 ? (bbUpper - bbLower) / bbBasis : 0.0

delta = close - close[1]
gain = math.max(delta, 0.0)
loss = math.max(-delta, 0.0)
avgGain = ta.sma(gain, 14)
avgLoss = ta.sma(loss, 14)

float rsi14 = na
if avgLoss == 0
    rsi14 := avgGain > 0 ? 100.0 : 50.0
else
    rs = avgGain / avgLoss
    rsi14 := 100.0 - (100.0 / (1.0 + rs))

previous20High = ta.highest(high, 20)[1]
previous20Low = ta.lowest(low, 20)[1]

// -------------------- REGIME --------------------

string regime = "UNCLEAR"

if atrPct >= 0.0025
    regime := "HIGH_VOLATILITY"
else if emaGapPct >= 0.00055 and emaSlopePct >= 0.00020
    regime := "TREND"
else if bbWidth <= 0.0018 and atrPct <= 0.0012
    regime := "RANGE"
else if bbWidth >= 0.0030 or emaSlopePct >= 0.00035
    regime := "BREAKOUT"

// -------------------- ACTION --------------------

string botAction = "HOLD"

if regime == "TREND"
    if ema20 > ema50 and close > ema20
        botAction := "BUY"
    else if ema20 < ema50 and close < ema20
        botAction := "SELL"

else if regime == "BREAKOUT"
    if close > previous20High
        botAction := "BUY"
    else if close < previous20Low
        botAction := "SELL"

else if regime == "RANGE"
    if close <= bbLower and rsi14 <= 35
        botAction := "BUY"
    else if close >= bbUpper and rsi14 >= 65
        botAction := "SELL"

else if regime == "HIGH_VOLATILITY"
    if close > previous20High
        botAction := "BUY"
    else if close < previous20Low
        botAction := "SELL"

regimeId = regime == "TREND" ? 1 : regime == "BREAKOUT" ? 2 : regime == "RANGE" ? 3 : regime == "HIGH_VOLATILITY" ? 4 : 0

enoughHistory = bar_index >= 60
marketAllowed = not tradeOnly1m or is1m

// ORIGINAL signals. Optimizer never removes these from the chart.
rawBuySignal = marketAllowed and enoughHistory and allowLong and botAction == "BUY"
rawSellSignal = marketAllowed and enoughHistory and allowShort and botAction == "SELL"

confirmedBuySignal = rawBuySignal and (not confirmedOnly or barstate.isconfirmed)
confirmedSellSignal = rawSellSignal and (not confirmedOnly or barstate.isconfirmed)

// ============================================================
// PERFORMANCE SCORING
// ============================================================

var int pendingDirection = 0
var int pendingStrategy = 0
var float pendingClose = na

var int trendWins = 0
var int trendLosses = 0
var int breakoutWins = 0
var int breakoutLosses = 0
var int rangeWins = 0
var int rangeLosses = 0
var int highVolWins = 0
var int highVolLosses = 0

if barstate.isconfirmed and pendingDirection != 0
    bool win = pendingDirection == 1 ? close > pendingClose : close < pendingClose
    bool lossResult = pendingDirection == 1 ? close < pendingClose : close > pendingClose

    if pendingStrategy == 1
        if win
            trendWins += 1
        else if lossResult
            trendLosses += 1

    else if pendingStrategy == 2
        if win
            breakoutWins += 1
        else if lossResult
            breakoutLosses += 1

    else if pendingStrategy == 3
        if win
            rangeWins += 1
        else if lossResult
            rangeLosses += 1

    else if pendingStrategy == 4
        if win
            highVolWins += 1
        else if lossResult
            highVolLosses += 1

    pendingDirection := 0
    pendingStrategy := 0
    pendingClose := na

if barstate.isconfirmed
    if confirmedBuySignal and not confirmedSellSignal
        pendingDirection := 1
        pendingClose := close
        pendingStrategy := regimeId

    else if confirmedSellSignal and not confirmedBuySignal
        pendingDirection := -1
        pendingClose := close
        pendingStrategy := regimeId

trendTotal = trendWins + trendLosses
breakoutTotal = breakoutWins + breakoutLosses
rangeTotal = rangeWins + rangeLosses
highVolTotal = highVolWins + highVolLosses

winRate(int wins, int losses) =>
    total = wins + losses
    total > 0 ? wins * 100.0 / total : na

trendWR = winRate(trendWins, trendLosses)
breakoutWR = winRate(breakoutWins, breakoutLosses)
rangeWR = winRate(rangeWins, rangeLosses)
highVolWR = winRate(highVolWins, highVolLosses)

// -------------------- AUTO OPTIMIZER --------------------

bool trendMature = trendTotal >= minTrades
bool breakoutMature = breakoutTotal >= minTrades
bool rangeMature = rangeTotal >= minTrades
bool highVolMature = highVolTotal >= minTrades

float weakestWR = 101.0
int weakestId = 0

if trendMature and trendWR < weakestWR
    weakestWR := trendWR
    weakestId := 1

if breakoutMature and breakoutWR < weakestWR
    weakestWR := breakoutWR
    weakestId := 2

if rangeMature and rangeWR < weakestWR
    weakestWR := rangeWR
    weakestId := 3

if highVolMature and highVolWR < weakestWR
    weakestWR := highVolWR
    weakestId := 4

bool disabledWeakest = autoDisable and weakestId != 0 and weakestWR < minWinRate
bool regimeAllowed = not disabledWeakest or regimeId != weakestId

tradeBuySignal = confirmedBuySignal and regimeAllowed
tradeSellSignal = confirmedSellSignal and regimeAllowed

// ============================================================
// STRATEGY TESTER ORDERS
// ============================================================

var int orderBar = na

if strategy.position_size == 0 and (tradeBuySignal or tradeSellSignal)
    if tradeBuySignal
        strategy.entry("BUY", strategy.long)
    else if tradeSellSignal
        strategy.entry("SELL", strategy.short)
    orderBar := bar_index

if strategy.position_size != 0 and not na(orderBar) and bar_index > orderBar
    strategy.close_all(comment="NEXT BAR")
    orderBar := na

// ============================================================
// CLEAR HISTORICAL SIGNALS
// BUY below candle, SELL above candle.
// Separate plotshapes allow the strategy name to be shown.
// ============================================================

string trendBuyText = showSignalStrategy ? "BUY\nTREND" : "BUY"
string trendSellText = showSignalStrategy ? "SELL\nTREND" : "SELL"

string breakoutBuyText = showSignalStrategy ? "BUY\nBREAKOUT" : "BUY"
string breakoutSellText = showSignalStrategy ? "SELL\nBREAKOUT" : "SELL"

string rangeBuyText = showSignalStrategy ? "BUY\nRANGE" : "BUY"
string rangeSellText = showSignalStrategy ? "SELL\nRANGE" : "SELL"

string highVolBuyText = showSignalStrategy ? "BUY\nHIGH VOL" : "BUY"
string highVolSellText = showSignalStrategy ? "SELL\nHIGH VOL" : "SELL"

// TREND
plotshape(showSignals and confirmedBuySignal and regimeId == 1, title="BUY TREND", style=shape.labelup, location=location.belowbar, text=trendBuyText, size=size.tiny)
plotshape(showSignals and confirmedSellSignal and regimeId == 1, title="SELL TREND", style=shape.labeldown, location=location.abovebar, text=trendSellText, size=size.tiny)

// BREAKOUT
plotshape(showSignals and confirmedBuySignal and regimeId == 2, title="BUY BREAKOUT", style=shape.labelup, location=location.belowbar, text=breakoutBuyText, size=size.tiny)
plotshape(showSignals and confirmedSellSignal and regimeId == 2, title="SELL BREAKOUT", style=shape.labeldown, location=location.abovebar, text=breakoutSellText, size=size.tiny)

// RANGE
plotshape(showSignals and confirmedBuySignal and regimeId == 3, title="BUY RANGE", style=shape.labelup, location=location.belowbar, text=rangeBuyText, size=size.tiny)
plotshape(showSignals and confirmedSellSignal and regimeId == 3, title="SELL RANGE", style=shape.labeldown, location=location.abovebar, text=rangeSellText, size=size.tiny)

// HIGH VOLATILITY
plotshape(showSignals and confirmedBuySignal and regimeId == 4, title="BUY HIGH VOL", style=shape.labelup, location=location.belowbar, text=highVolBuyText, size=size.tiny)
plotshape(showSignals and confirmedSellSignal and regimeId == 4, title="SELL HIGH VOL", style=shape.labeldown, location=location.abovebar, text=highVolSellText, size=size.tiny)

// ============================================================
// LIVE SIGNAL
// Only the current forming candle can show LIVE.
// It may change/disappear before candle close.
// ============================================================

plotshape(showLiveSignal and barstate.isrealtime and rawBuySignal and not barstate.isconfirmed, title="LIVE BUY", style=shape.labelup, location=location.belowbar, text="LIVE BUY", size=size.small)
plotshape(showLiveSignal and barstate.isrealtime and rawSellSignal and not barstate.isconfirmed, title="LIVE SELL", style=shape.labeldown, location=location.abovebar, text="LIVE SELL", size=size.small)

// ============================================================
// ALERTS
// ============================================================

alertcondition(rawBuySignal, title="MMC BUY", message="MMC BUY signal")
alertcondition(rawSellSignal, title="MMC SELL", message="MMC SELL signal")

// ============================================================
// STATS
// ============================================================

totalWins = trendWins + breakoutWins + rangeWins + highVolWins
totalLosses = trendLosses + breakoutLosses + rangeLosses + highVolLosses
totalTrades = totalWins + totalLosses
overallWR = winRate(totalWins, totalLosses)

string weakestName = weakestId == 1 ? "TREND" : weakestId == 2 ? "BREAKOUT" : weakestId == 3 ? "RANGE" : weakestId == 4 ? "HIGH VOL" : "NONE"
string statusText = disabledWeakest ? "OFF: " + weakestName + " (" + str.tostring(weakestWR, "#.##") + "%)" : "ALL ON"

var table t = table.new(position.top_right, 6, 6, border_width=1)

if showStats and barstate.islast
    table.cell(t, 0, 0, "STRATEGY")
    table.cell(t, 1, 0, "WIN")
    table.cell(t, 2, 0, "LOSS")
    table.cell(t, 3, 0, "TOTAL")
    table.cell(t, 4, 0, "WIN %")
    table.cell(t, 5, 0, "TRADE")

    table.cell(t, 0, 1, "TREND")
    table.cell(t, 1, 1, str.tostring(trendWins))
    table.cell(t, 2, 1, str.tostring(trendLosses))
    table.cell(t, 3, 1, str.tostring(trendTotal))
    table.cell(t, 4, 1, na(trendWR) ? "-" : str.tostring(trendWR, "#.##") + "%")
    table.cell(t, 5, 1, disabledWeakest and weakestId == 1 ? "OFF" : "ON")

    table.cell(t, 0, 2, "BREAKOUT")
    table.cell(t, 1, 2, str.tostring(breakoutWins))
    table.cell(t, 2, 2, str.tostring(breakoutLosses))
    table.cell(t, 3, 2, str.tostring(breakoutTotal))
    table.cell(t, 4, 2, na(breakoutWR) ? "-" : str.tostring(breakoutWR, "#.##") + "%")
    table.cell(t, 5, 2, disabledWeakest and weakestId == 2 ? "OFF" : "ON")

    table.cell(t, 0, 3, "RANGE")
    table.cell(t, 1, 3, str.tostring(rangeWins))
    table.cell(t, 2, 3, str.tostring(rangeLosses))
    table.cell(t, 3, 3, str.tostring(rangeTotal))
    table.cell(t, 4, 3, na(rangeWR) ? "-" : str.tostring(rangeWR, "#.##") + "%")
    table.cell(t, 5, 3, disabledWeakest and weakestId == 3 ? "OFF" : "ON")

    table.cell(t, 0, 4, "HIGH VOL")
    table.cell(t, 1, 4, str.tostring(highVolWins))
    table.cell(t, 2, 4, str.tostring(highVolLosses))
    table.cell(t, 3, 4, str.tostring(highVolTotal))
    table.cell(t, 4, 4, na(highVolWR) ? "-" : str.tostring(highVolWR, "#.##") + "%")
    table.cell(t, 5, 4, disabledWeakest and weakestId == 4 ? "OFF" : "ON")

    table.cell(t, 0, 5, "OVERALL")
    table.cell(t, 1, 5, str.tostring(totalWins))
    table.cell(t, 2, 5, str.tostring(totalLosses))
    table.cell(t, 3, 5, str.tostring(totalTrades))
    table.cell(t, 4, 5, na(overallWR) ? "-" : str.tostring(overallWR, "#.##") + "%")
    table.cell(t, 5, 5, statusText)

plot(ema20, "EMA 20")
plot(ema50, "EMA 50")
